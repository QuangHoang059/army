PORT=4000
DB_PATH=./data/army.db
CORS_ORIGIN=http://localhost:3000

# Tài khoản admin đầu tiên — chỉ dùng khi DB chưa có tài khoản nào (mặc định admin / admin123)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=doi-mat-khau-nay
# Số ngày giữ đăng nhập
# SESSION_DAYS=7

# Sao lưu tự động (thư mục backups/ cạnh data/): mỗi bao nhiêu giờ (0 = tắt), giữ bao nhiêu bản
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=30
